{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/run.schema.json",
  "title": "idev run",
  "description": "A run instance. Also the projection written back to run.yaml during the migration, which is why the step status values are the old ones unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "workflow_id", "feature", "status", "steps"],
  "properties": {
    "schema": { "const": "idev.run/2" },
    "run_id": { "$ref": "common.schema.json#/$defs/ulid" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "recipe": { "type": "string" },
    "recipe_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "feature": { "$ref": "common.schema.json#/$defs/featureKey" },
    "status": { "$ref": "common.schema.json#/$defs/runStatus" },
    "track": { "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"] },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "params": { "type": "object" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_fail": { "enum": ["stop", "ask"] },
        "on_gate": { "enum": ["stop"] },
        "on_case_fail": { "enum": ["stop_fix_continue"] },
        "require_clean_pass": { "type": "boolean" },
        "max_clean_attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "assets": { "$ref": "common.schema.json#/$defs/assetsRef" },
    "baseline": { "$ref": "common.schema.json#/$defs/baselineRef" },

    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "kinds.schema.json#/$defs/kind" },
          "label": { "type": "string" },
          "with": { "type": "object" },
          "state": {
            "description": "The in-flight state. Absent on a step that has not started.",
            "enum": [
              "pending", "ready", "delegated", "conductor_active",
              "awaiting_signoff", "returned", "verifying"
            ]
          },
          "status": { "$ref": "common.schema.json#/$defs/stepStatus" },
          "at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "attempt": { "type": "integer", "minimum": 1 },
          "evidence": { "type": "string" },
          "note": { "type": "string" },
          "writer": { "type": "string" },
          "verifier": { "type": "string" },
          "signoff": {
            "description": "Projected from an approval record; never written by hand. A signoff with no approval_id is treated as unsigned from P3 on.",
            "type": "object",
            "additionalProperties": false,
            "required": ["by", "at"],
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "quote": { "type": "string" },
              "at": { "$ref": "common.schema.json#/$defs/timestamp" },
              "approval_id": { "$ref": "common.schema.json#/$defs/ulid" },
              "digest": { "$ref": "common.schema.json#/$defs/digest" }
            }
          }
        },
        "allOf": [
          {
            "description": "A PASS records where to look.",
            "if": {
              "properties": { "status": { "const": "PASS" } },
              "required": ["status"]
            },
            "then": { "required": ["evidence"] }
          }
        ]
      }
    },

    "revisions": {
      "description": "Append-only. A changed step keeps its old value here rather than losing it.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "note"],
        "properties": {
          "at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "step": { "type": "string" },
          "from": { "$ref": "common.schema.json#/$defs/stepStatus" },
          "to": { "$ref": "common.schema.json#/$defs/stepStatus" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "sent", "accepted", "rejected"] },
        "note": { "type": "string" }
      }
    },
    "drift": {
      "description": "True when the sealed baseline no longer matches the files. Blocks the run without changing any step, because the steps are not what went wrong.",
      "type": "boolean"
    }
  },

  "allOf": [
    {
      "description": "Duplicate step ids make a run unaddressable.",
      "properties": {
        "steps": {
          "uniqueItems": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/workspace_manifest.input.schema.json",
  "title": "idev MCP workspace_manifest input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(-|[a-z0-9][a-z0-9-]*)$"
    },
    "repo_root": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  }
}

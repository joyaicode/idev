{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/baseline_sealed.input.schema.json",
  "title": "idev MCP baseline_sealed input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(-|[a-z0-9][a-z0-9-]*)$"
    }
  }
}

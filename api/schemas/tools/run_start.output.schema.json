{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/run_start.output.schema.json",
  "title": "idev MCP run_start output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "awaiting_human",
        "blocked",
        "done",
        "aborted"
      ]
    }
  }
}

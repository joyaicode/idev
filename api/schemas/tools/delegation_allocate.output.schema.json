{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/delegation_allocate.output.schema.json",
  "title": "idev MCP delegation_allocate output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "run_id",
    "step_id",
    "attempt",
    "agent"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "step_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "agent": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/audit_export.output.schema.json",
  "title": "idev MCP audit_export output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "count",
    "events"
  ],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}

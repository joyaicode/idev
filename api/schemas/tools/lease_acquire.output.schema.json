{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idev.dev/schemas/lease_acquire.output.schema.json",
  "title": "idev MCP lease_acquire output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "fencing",
    "token",
    "expires_at"
  ],
  "properties": {
    "lease_id": {
      "type": "string"
    },
    "fencing": {
      "type": "integer",
      "minimum": 1
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

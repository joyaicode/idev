
# idev session residue. Product line under .idev is tracked.
.idev/*
!.idev/handoff.yaml
!.idev/workflow-defaults.yaml
!.idev/workflows/
!.idev/workflows/**
!.idev/pack/
!.idev/pack/**
!.idev/task/
!.idev/task/**
!.idev/docs/
!.idev/docs/**

# flock residue from safeyaml's load_locked/save_locked: the lock file
# outlives the process that held it, and it is always empty.
state/*.lock

# Optional offline Qodana CLI and linter. Drop a binary here; do not commit it.
/offline/

# Local CodeGraph index. Refreshed before commit and push; not part of the tree.
/.codegraph/

# Local run residue. Audits and evolve still read these on disk; they are not
# part of the published tree. (Proposal 20261027 §6: untrack, do not rewrite history.)
/state/traces/
/state/reviews/
/state/promptfoo/
/state/outbound-config.json
/state/proposals/
/state/lessons.yaml
/state/lessons/
/state/sediment.yaml
/state/ledger.yaml
/verify/target/

# Go build and test residue. bin/idev is built locally (workflow.py looks there).
/bin/
/cover.out
/coverage.out

# rapid writes a failfile when a property test fails, to replay that exact
# input. They are repro artefacts tied to one run's draw sequence — and the
# ones that show up during mutation testing come from deliberately broken
# code, so committing them would preserve a "failure" of something that was
# never wrong. A property worth keeping becomes a named test instead.
testdata/rapid/

# Go fuzz corpora are cached in GOCACHE; a seed worth keeping goes in the
# test as an f.Add.
testdata/fuzz/
# idev: execution residue stays untracked; durable product characteristics stay
.idev/*
!.idev/memory.md
!.idev/marker.yaml
!.idev/extensions.yaml
!.idev/handoff.yaml
!.idev/workflow-defaults.yaml
!.idev/strip-tokens.txt
!.idev/pack/
!.idev/workflows/
!.idev/checks/
!.idev/task/
!.idev/task/**
!.idev/docs/
!.idev/docs/**

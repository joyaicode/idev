
# idev session residue. Product line under .idev is tracked.
.idev/*
!.idev/handoff.yaml
!.idev/workflow-defaults.yaml
!.idev/workflows/
!.idev/workflows/**
!.idev/pack/
!.idev/pack/**
!.idev/task/
!.idev/task/**
!.idev/docs/
!.idev/docs/**

# VSCode changelists.json is per-user local grouping state, not product content.
.vscode/changelists.json

# flock residue from safeyaml's load_locked/save_locked: the lock file
# outlives the process that held it, and it is always empty.
state/*.lock

# Optional offline Qodana CLI and linter. Drop a binary here; do not commit it.
/offline/

# Local CodeGraph index. Refreshed before commit and push; not part of the tree.
/.codegraph/

# Local run residue. Audits and evolve still read these on disk; they are not
# part of the published tree. (Proposal 20261027 §6: untrack, do not rewrite history.)
/state/traces/
/state/reviews/
/state/promptfoo/
/state/outbound-config.json
/state/proposals/
/state/research/
/state/lessons.yaml
/state/lessons/
/state/sediment.yaml
/state/ledger.yaml
/state/knowledge-index/
/state/knowledge-questions.yaml
/verify/target/

# Go build and test residue. bin/idev is built locally (workflow.py looks there).
/bin/
/cover.out
/coverage.out

# rapid writes a failfile when a property test fails, to replay that exact
# input. They are repro artefacts tied to one run's draw sequence — and the
# ones that show up during mutation testing come from deliberately broken
# code, so committing them would preserve a "failure" of something that was
# never wrong. A property worth keeping becomes a named test instead.
testdata/rapid/

# Go fuzz corpora are cached in GOCACHE; a seed worth keeping goes in the
# test as an f.Add.
testdata/fuzz/

# Reading material behind the conventions work. The books and their OCR are
# large and reproducible — the book is on the shelf, the OCR can be run again.
# What comes out of a close reading is neither: a 精读缺口 report is hours of
# reading checked against the real source, and nothing regenerates it. So the
# raw material is excluded and the distilled output stays trackable. Without
# the split, the 592K that matters has no history while one `git add .` would
# put 190M that does not into it permanently.
/scripts/docs/*.pdf
/scripts/docs/notes/*-OCR.txt
/scripts/docs/notes/*-OCR.p*.txt
/scripts/docs/notes/*-全文.txt

# Python bytecode. Regenerated on every import, and a .pyc from another
# interpreter version is noise in a repo that already has to care which
# python3 it got.
__pycache__/
*.py[co]

# One-off local console and OCR logs; they are run residue, not book notes.
/state/console/
/ocr*.log

# idev: execution residue stays untracked; durable product characteristics stay
.idev/*
!.idev/memory.md
!.idev/marker.yaml
!.idev/extensions.yaml
!.idev/handoff.yaml
!.idev/workflow-defaults.yaml
!.idev/strip-tokens.txt
!.idev/pack/
!.idev/workflows/
!.idev/checks/
!.idev/task/
!.idev/task/**
!.idev/docs/
!.idev/docs/**
